classDiagram

class MainApplication {
    +FastAPI app
    +root()
    +health_check()
}

class Settings {
    +database_url
    +jwt_secret
    +load_configuration()
}

class API {
    +Authentication
    +Admin
    +Catalog
    +Tickets
    +TicketComments
}

class Schemas {
    +UserCreate
    +UserLogin
    +UserResponse
    +TokenResponse
    +TicketCreate
    +TicketResponse
    +TicketUpdate
    +TicketCommentCreate
    +TicketCommentResponse
}

class Services {
    +UserService
    +TicketService
    +TicketCommentService
}

class Repositories {
    +UserRepository
    +TicketRepository
    +CategoryRepository
    +PriorityRepository
    +TicketCommentRepository
}

class Dependencies {
    +get_current_user()
    +require_agent_or_admin()
    +require_admin()
}

class Security {
    +hash_password()
    +verify_password()
    +create_access_token()
    +decode_access_token()
}

class Database {
    +engine
    +SessionLocal
    +Base
    +get_db()
}

class Models {
    +User
    +Ticket
    +Category
    +Priority
    +TicketComment
}

class PostgreSQL {
    +helpdesk_saas
    +Port 5432
}

MainApplication --> API : routes requests
MainApplication --> Settings : loads configuration

API --> Schemas : validates requests
API --> Services : calls business operations
API --> Dependencies : protects routes

Services --> Repositories : uses data access
Services --> Models : applies business rules

Repositories --> Database : performs queries
Repositories --> Models : reads and writes entities

Dependencies --> Security : validates JWT
Security --> Settings : uses JWT configuration

Database --> Settings : reads database configuration
Database --> Models : maps entities
Database --> PostgreSQL : SQL connections